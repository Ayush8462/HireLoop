NODE_ENV=development

PORT=5004

MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/hireloop-notifications

# Must match JWT_ACCESS_SECRET in auth-service
JWT_ACCESS_SECRET=jwt_secret_key_for_access_secret_for_hireloop

# Shared secret for internal service-to-service calls
NOTIFICATION_INTERNAL_SECRET=your_internal_secret_here

# Gmail SMTP credentials (use App Password, not your real password)
# 1. Enable 2FA on Gmail
# 2. Go to Google Account > Security > App Passwords
# 3. Generate an App Password for HireLoop
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# URL of auth-service (for email lookups)
AUTH_SERVICE_URL=http://auth-service:5001

# Frontend URL for email links
CLIENT_URL=http://localhost:5173
